# Cloudflare Pages response headers (copied into dist/ by the build).

# Hashed build assets never change under the same URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Keep the *.pages.dev addresses (production and per-branch previews) out of
# search results; the real site is the custom domain. Without this, Google
# can index the same pages on two hosts.
https://:project.pages.dev/*
  X-Robots-Tag: noindex
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
