---
import type { NovaGroup } from '../../pipeline/lib/types.ts';
import Base from '../layouts/Base.astro';
import NovaBar from '../components/NovaBar.astro';
import NovaScale from '../components/NovaScale.astro';
import ProductThumb from '../components/ProductThumb.astro';
import ProductTiles from '../components/ProductTiles.astro';
import SearchBox from '../components/SearchBox.astro';
import {
  categories,
  categoryHref,
  categoryImage,
  formatNumber,
  href,
  lowerFirst,
  markerHref,
  markers,
  meta,
  percent,
  productHref,
  products,
} from '../lib/data.ts';
import { SITE } from '../lib/site.ts';

// Products are sorted by popularity, so the head of the list is what people scan most.
const popular = products.filter((p) => p.image).slice(0, 8);

// Mid-sized categories make better entry points than huge generic ones.
const featured = [...categories]
  .filter((c) => c.count >= 20 && c.count <= 400)
  .sort((a, b) => b.count - a.count)
  .slice(0, 10)
  .sort((a, b) => percent(a.novaCounts[4], a.count) - percent(b.novaCounts[4], b.count))
  .map((c) => ({
    category: c,
    image: categoryImage(c),
    // shown (as its icon) only when no product in the category has a photo
    commonest: ([1, 2, 3, 4] as NovaGroup[]).reduce((a, b) => (c.novaCounts[b] > c.novaCounts[a] ? b : a)),
  }));

const topMarkers = markers.filter((m) => m.group === 4).slice(0, 10);
const ultraShare = percent(meta.novaCounts[4], products.length);

// "Try" links under the search box: one product from each end of the scale,
// one ingredient and one category, so a first visit has somewhere to click.
const examples = [
  products.find((p) => p.nova === 4 && p.image),
  products.find((p) => p.nova === 1 && p.image),
]
  .filter((p) => p !== undefined)
  .map((p) => ({ text: p.name, url: productHref(p) }));
const exampleMarker = markers.find((m) => m.tag === 'en:maltodextrin') ?? topMarkers[0];
if (exampleMarker) examples.push({ text: lowerFirst(exampleMarker.name), url: markerHref(exampleMarker) });
const exampleCategory = categories.find((c) => c.tag === 'en:breakfast-cereals') ?? featured[0]?.category;
if (exampleCategory) examples.push({ text: lowerFirst(exampleCategory.name), url: categoryHref(exampleCategory) });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: SITE.alternateName,
    url: new URL(href(), Astro.site).href,
    description: SITE.tagline,
  },
];
---

<Base title={SITE.name} description={`${SITE.tagline} NOVA groups for ${formatNumber(products.length)} products from Open Food Facts.`} jsonLd={jsonLd} hideHeaderSearch>
  <section class="hero">
    <h1>Is it ultra-processed?</h1>
    <p class="lede">
      Look up a packaged food to see how processed it is, why, and what to buy instead.
    </p>
    <SearchBox variant="full" />
    {
      examples.length > 0 && (
        <p class="try">
          <span class="meta">Try</span>
          {examples.map((e) => (
            <a href={e.url}>{e.text}</a>
          ))}
        </p>
      )
    }
  </section>

  <section aria-labelledby="groups">
    <h2 id="groups">From farm to factory: the four groups</h2>
    <p>
      NOVA sorts food by how much, and why, it has been processed. It was developed at the University of São Paulo and is
      the scale behind most research on ultra-processed food.
    </p>
    <NovaScale variant="explain" />
    <p>
      Of the {formatNumber(products.length)} products here, {ultraShare}% are ultra-processed.
      <a href={href('what-is-nova/')}>How the groups work</a>
    </p>
    <NovaBar counts={meta.novaCounts} />
  </section>

  <section aria-labelledby="popular">
    <h2 id="popular">Most looked-up products</h2>
    <ProductTiles products={popular} />
  </section>

  <section aria-labelledby="cats">
    <h2 id="cats">Browse by category</h2>
    <ul class="cat-list">
      {
        featured.map(({ category: c, image, commonest }) => (
          <li>
            <a href={categoryHref(c)}>
              <span class="cat-text">
                <span class="cat-name">{c.name}</span>
                <span class="meta">
                  {percent(c.novaCounts[4], c.count)}% of {c.count} ultra-processed
                </span>
                <NovaBar counts={c.novaCounts} mini />
              </span>
              <ProductThumb product={{ image, nova: commonest }} size={48} />
            </a>
          </li>
        ))
      }
    </ul>
    <p><a href={href('categories/')}>All {categories.length} categories</a></p>
  </section>

  <section aria-labelledby="markers">
    <h2 id="markers">The most common signs of ultra-processing</h2>
    <ul class="chips">
      {
        topMarkers.map((m) => (
          <li>
            <a href={markerHref(m)}>
              {m.eNumber ? `${m.eNumber} ${m.name}` : m.name} <span class="count">{formatNumber(m.count)}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p>
      <a href={href('ingredients/')}>All ingredients</a> · <a href={href('additives/')}>All additives</a>
    </p>
  </section>
</Base>

<style>
  .hero {
    padding: 1rem 0 0.5rem;
  }
  .hero h1 {
    font-size: clamp(2.5rem, 7vw, 4.5rem);
    font-stretch: 125%;
    max-width: 14ch;
  }
  .try {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
    max-width: 40rem;
    margin-top: 0.25rem;
  }

  .cat-list {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    column-gap: 2.5rem;
    max-width: 56rem;
  }
  .cat-list li {
    border-bottom: 1px solid var(--rule);
  }
  .cat-list a {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0;
    color: var(--text);
    text-decoration: none;
  }
  /* photo first visually; name first for screen readers */
  .cat-list a > :global(.thumb) {
    order: -1;
  }
  .cat-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
    min-width: 0;
  }
  .cat-name {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }
  .cat-list a:hover .cat-name {
    text-decoration-thickness: 2px;
  }
  .cat-text .meta {
    font-size: 0.85rem;
  }

  .chips {
    list-style: none;
    padding: 0;
    margin: 1rem 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    max-width: 56rem;
  }
  .chips a {
    display: inline-block;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 2px;
    color: var(--text);
    text-decoration: none;
  }
  .chips a:hover {
    border-color: var(--text);
  }
  .count {
    color: var(--muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }
</style>
