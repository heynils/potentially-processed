---
import Base from '../../layouts/Base.astro';
import { formatNumber, markerHref, markers, products } from '../../lib/data.ts';

const list = markers.filter((m) => m.kind === 'additive');
const ultra = list.filter((m) => m.group === 4);
const processed = list.filter((m) => m.group === 3);
const label = (m: (typeof list)[number]) => (m.eNumber ? `${m.eNumber} ${m.name}` : m.name);
---

<Base
  title="Additives that mark a food as processed or ultra-processed"
  description={`${list.length} additives that Open Food Facts uses to place foods in a NOVA group, with how often each appears among ${formatNumber(products.length)} products.`}
>
  <h1>Additives</h1>
  <p class="lede">
    The additives that Open Food Facts uses as NOVA markers, by how many of the {formatNumber(products.length)} products
    on this site contain them.
  </p>
  {
    ultra.length > 0 && (
      <section>
        <h2>Markers of ultra-processing (group 4)</h2>
        <ul class="markers">
          {ultra.map((m) => (
            <li>
              <a href={markerHref(m)}>{label(m)}</a> <span class="meta">{formatNumber(m.count)} products</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  {
    processed.length > 0 && (
      <section>
        <h2>Markers of processing (group 3)</h2>
        <ul class="markers">
          {processed.map((m) => (
            <li>
              <a href={markerHref(m)}>{label(m)}</a> <span class="meta">{formatNumber(m.count)} products</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .markers {
    columns: 2 18rem;
    padding-left: 1.2rem;
    max-width: 56rem;
  }
  .markers li {
    break-inside: avoid;
    margin-bottom: 0.3rem;
  }
</style>
