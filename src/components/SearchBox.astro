---
import { href, servedCountries } from '../lib/data.ts';

interface Props {
  /** "compact": header form that submits to /search/. "full": live results below the box. */
  variant?: 'compact' | 'full';
  autofocus?: boolean;
}

const { variant = 'full', autofocus = false } = Astro.props;
const id = variant === 'compact' ? 'q-header' : 'q';
---

{
  variant === 'compact' ? (
    <form class="search-compact" role="search" action={href('search/')} method="get">
      <label class="visually-hidden" for={id}>
        Search products
      </label>
      <input id={id} type="search" name="q" placeholder="Search products" autocomplete="off" />
      <button type="submit">Search</button>
    </form>
  ) : (
    <div class="search-full" data-search>
      <form role="search" action={href('search/')} method="get">
        <label for={id}>Search by product, brand, ingredient or category</label>
        <div class="row">
          <input
            id={id}
            type="search"
            name="q"
            placeholder="e.g. granola, Heinz, maltodextrin"
            autocomplete="off"
            autofocus={autofocus}
            aria-controls="search-results"
          />
          <button type="submit">Search</button>
        </div>
        {servedCountries.length > 1 && (
          <p class="where">
            <label for={`${id}-country`}>Sold in</label>
            <select id={`${id}-country`} name="country" data-country aria-controls="search-results">
              <option value="">any country</option>
              {servedCountries.map((c) => (
                <option value={c.name}>{c.name}</option>
              ))}
            </select>
          </p>
        )}
      </form>
      <p class="status meta" aria-live="polite" data-status />
      <ol id="search-results" class="results" data-results />
    </div>
  )
}

<script>
  // Pagefind is a static search index generated after `astro build`
  // (see the "build" script). The browser downloads only the index chunks a
  // query needs, so there is no search server.
  type PagefindResult = {
    url: string;
    excerpt: string;
    meta: { title?: string; nova?: string; brand?: string; kind?: string; image?: string };
  };
  type SearchOptions = { filters?: Record<string, string> };
  type Pagefind = {
    options: (o: { baseUrl?: string; excerptLength?: number }) => Promise<void>;
    debouncedSearch: (q: string, opts?: SearchOptions, ms?: number) => Promise<{ results: { data: () => Promise<PagefindResult> }[] } | null>;
  };

  // The "Sold in" choice is remembered on this device (a convenience: the
  // page works the same when storage is blocked).
  const COUNTRY_KEY = 'search-country';
  const loadCountry = () => {
    try {
      return localStorage.getItem(COUNTRY_KEY) ?? '';
    } catch {
      return '';
    }
  };
  const saveCountry = (value: string) => {
    try {
      if (value) localStorage.setItem(COUNTRY_KEY, value);
      else localStorage.removeItem(COUNTRY_KEY);
    } catch {
      // storage unavailable: the choice lasts for this page only
    }
  };

  const base = import.meta.env.BASE_URL;
  let pagefind: Promise<Pagefind> | null = null;

  function loadPagefind(): Promise<Pagefind> {
    pagefind ??= import(/* @vite-ignore */ `${base}pagefind/pagefind.js`).then(async (pf: Pagefind) => {
      // Short excerpts keep a page of results scannable on a phone.
      await pf.options({ baseUrl: base, excerptLength: 14 });
      return pf;
    });
    return pagefind;
  }

  const escapeHtml = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function render(list: HTMLElement, items: PagefindResult[]) {
    list.innerHTML = items
      .map((r) => {
        const nova = r.meta.nova ? `<span class="nova-chip nova-chip-${escapeHtml(r.meta.nova)}">NOVA ${escapeHtml(r.meta.nova)}</span>` : '';
        const sub = [r.meta.kind, r.meta.brand].filter(Boolean).map((s) => escapeHtml(s!)).join(' · ');
        // Product pages give Pagefind a 100 px photo (see products/[slug].astro).
        // Pages without a photo declare "none" (see the pages' data-pagefind-meta).
        const thumb = r.meta.image && r.meta.image !== 'none'
          ? `<img class="thumb" src="${escapeHtml(r.meta.image)}" alt="" width="44" height="44" loading="lazy" decoding="async" referrerpolicy="no-referrer">`
          : '<span class="thumb" aria-hidden="true"></span>';
        // Pagefind excerpts are already HTML-escaped, with <mark> around matches.
        return `<li>${thumb}<div class="hit">${nova}<a href="${escapeHtml(r.url)}">${escapeHtml(r.meta.title ?? r.url)}</a>${sub ? `<span class="sub">${sub}</span>` : ''}<p class="excerpt">${r.excerpt}</p></div></li>`;
      })
      .join('');
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-search]')) {
    const input = root.querySelector('input')!;
    const country = root.querySelector<HTMLSelectElement>('[data-country]');
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const list = root.querySelector<HTMLElement>('[data-results]')!;

    async function run(query: string) {
      const q = query.trim();
      if (!q) {
        list.innerHTML = '';
        status.textContent = '';
        return;
      }
      let pf: Pagefind;
      try {
        pf = await loadPagefind();
      } catch {
        status.textContent = 'Search is not available in this build. Run `npm run build` to generate the index.';
        return;
      }
      // Product pages carry a "country" filter per country the site serves
      // (see products/[slug].astro); other pages have none, so a country
      // choice narrows the results to products.
      const where = country?.value ?? '';
      const search = await pf.debouncedSearch(q, where ? { filters: { country: where } } : {}, 200);
      if (search === null) return; // superseded by a newer keystroke
      const items = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      render(list, items);
      const n = search.results.length;
      const what = where ? `product${n === 1 ? '' : 's'} sold in ${where}` : `result${n === 1 ? '' : 's'}`;
      status.textContent =
        n === 0 ? `No ${where ? `products sold in ${where}` : 'results'} for “${q}”.` : `${n} ${what}${n > 20 ? ', showing the first 20' : ''}.`;
    }

    input.addEventListener('input', () => run(input.value));
    if (country) {
      const params = new URLSearchParams(location.search);
      const wanted = params.get('country') ?? loadCountry();
      if ([...country.options].some((o) => o.value === wanted)) country.value = wanted;
      country.addEventListener('change', () => {
        saveCountry(country.value);
        run(input.value);
      });
    }
    root.querySelector('form')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const url = new URL(location.href);
      if (url.pathname.endsWith('/search/')) {
        url.searchParams.set('q', input.value);
        history.replaceState(null, '', url);
      }
      run(input.value);
    });

    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      run(initial);
    }
    // Start fetching the index as soon as someone shows intent to search.
    input.addEventListener('focus', () => loadPagefind().catch(() => {}), { once: true });
  }
</script>

<style>
  .search-compact {
    display: flex;
    gap: 0.4rem;
  }

  input[type='search'] {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--muted);
    border-radius: 2px;
    padding: 0.45rem 0.6rem;
    min-width: 0;
  }

  .search-compact input {
    width: 13rem;
    font-size: 0.95rem;
  }

  button {
    font: inherit;
    font-weight: 650;
    font-stretch: 90%;
    color: var(--bg);
    background: var(--text);
    border: 1px solid var(--text);
    border-radius: 2px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
  }

  button:hover {
    background: var(--link-hover);
    border-color: var(--link-hover);
  }

  .search-compact button {
    font-size: 0.95rem;
  }

  .search-full label {
    display: block;
    font-weight: 650;
    margin-bottom: 0.4rem;
  }

  .search-full .row {
    display: flex;
    gap: 0.5rem;
    max-width: 40rem;
  }

  .search-full input {
    flex: 1;
    font-size: 1.15rem;
    padding: 0.65rem 0.8rem;
    border-width: 2px;
    border-color: var(--text);
  }

  .search-full button {
    font-size: 1.05rem;
    padding: 0.6rem 1.2rem;
  }

  .where {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.6rem 0 0;
    font-size: 0.95rem;
  }

  .where label {
    display: inline;
    margin: 0;
    font-weight: 500;
    color: var(--muted);
  }

  select {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--muted);
    border-radius: 2px;
    padding: 0.3rem 0.5rem;
  }

  .status {
    margin: 0.75rem 0 0.5rem;
    min-height: 1.4em;
  }

  .results {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 48rem;
  }

  .results :global(li) {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .results :global(.thumb) {
    width: 2.75rem;
    height: 2.75rem;
    object-fit: contain;
    background: var(--img-bg);
    border-radius: 2px;
  }

  .results :global(.hit > a) {
    font-weight: 650;
  }


  .results :global(.sub) {
    margin-left: 0.5rem;
    color: var(--muted);
    font-size: 0.9rem;
  }

  .results :global(.excerpt) {
    margin: 0.25rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .results :global(mark) {
    background: none;
    color: var(--text);
    font-weight: 650;
  }

  .results :global(.nova-chip) {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 750;
    font-stretch: 85%;
    padding: 0.05rem 0.4rem;
    margin-right: 0.5rem;
    border-radius: 2px;
    vertical-align: 0.1em;
  }

  .results :global(.nova-chip-1) {
    background: var(--nova-1);
    color: var(--nova-1-ink);
  }
  .results :global(.nova-chip-2) {
    background: var(--nova-2);
    color: var(--nova-2-ink);
  }
  .results :global(.nova-chip-3) {
    background: var(--nova-3);
    color: var(--nova-3-ink);
  }
  .results :global(.nova-chip-4) {
    background: var(--nova-4);
    color: var(--nova-4-ink);
  }

  @media (max-width: 40rem) {
    .search-compact {
      width: 100%;
    }
    .search-compact input {
      flex: 1;
      width: auto;
    }
  }
</style>
