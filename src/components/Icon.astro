---
// A Lucide icon from the shared sprite (see src/lib/icons.ts). It takes the
// text colour; width and height are set here, so nothing shifts while the
// sprite loads.
import { href } from '../lib/data.ts';
import type { IconName } from '../lib/icons.ts';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Accessible name; without one the icon is decorative and hidden from screen readers. */
  label?: string;
}

const { name, size = 24, class: className, label } = Astro.props;
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}><use href={`${href('icons.svg')}#${name}`} /></svg
>
