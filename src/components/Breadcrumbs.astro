---
interface Props {
  /** `lang` for a name that isn't English (a Swedish product's name). */
  items: { name: string; href?: string; lang?: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {item.href && i < items.length - 1 ? (
            <a href={item.href}>{item.name}</a>
          ) : (
            <span aria-current="page" lang={item.lang}>{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: flex;
    flex-wrap: wrap;
    font-size: 0.875rem;
    font-stretch: 90%;
    color: var(--muted);
  }
  .breadcrumbs li:not(:last-child)::after {
    content: '/';
    margin: 0 0.5rem;
    color: var(--rule);
  }
  .breadcrumbs a {
    color: var(--muted);
  }
</style>
