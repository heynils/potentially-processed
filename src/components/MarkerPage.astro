---
import type { NovaGroup, SiteMarker } from '../../pipeline/lib/types.ts';
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductList from './ProductList.astro';
import {
  categoryByTag,
  categoryHref,
  formatNumber,
  getProducts,
  href,
  labels,
  lowerFirst,
  percent,
  products,
} from '../lib/data.ts';
import { describeMarker, explainMarker, KINDS } from '../lib/explain.ts';

interface Props {
  marker: SiteMarker;
}

const MAX_LISTED = 60;
const { marker: m } = Astro.props;
// Name first: people search "is citric acid ultra-processed", rarely "E330".
const label = m.eNumber ? `${m.name} (${m.eNumber})` : m.name;
const lower = m.eNumber ? `${lowerFirst(m.name)} (${m.eNumber})` : lowerFirst(m.name);
const listed = getProducts(m.codes.slice(0, MAX_LISTED));
const classes = m.classes.map((c) => labels.additiveClasses[c]).filter(Boolean);
const kindLabel = m.kind === 'additive' ? 'Additives' : 'Ingredients';
const novaCounts: Record<NovaGroup, number> = { 1: 0, 2: 0, 3: 0, 4: 0 };
for (const p of getProducts(m.codes)) novaCounts[p.nova]++;
const ultraShare = percent(novaCounts[4], m.count);

const verdict =
  m.group === 4
    ? `${label} is one of the markers Open Food Facts uses to classify a food as ultra-processed (NOVA group 4).`
    : m.group === 3
      ? `${label} is not a marker of ultra-processing. It is one of the markers Open Food Facts uses to classify a food as processed (NOVA group 3).`
      : `No. ${label} is not one of the markers Open Food Facts uses to classify a food as processed or ultra-processed, so on its own it doesn't raise a product's NOVA group.`;

const explained =
  m.group === null ? null : explainMarker({ tag: m.tag, type: m.kind === 'additive' ? 'additives' : 'ingredients', group: m.group });
// Non-markers have no NOVA group; describeMarker only uses the group for categories.
const description = explained?.description ?? describeMarker({ tag: m.tag, type: 'additives', group: 3 });
const title =
  m.group === 4 ? `Is ${lower} ultra-processed?` : m.group === 3 ? `Is ${lower} ultra-processed? No, but processed` : `Is ${lower} ultra-processed?`;
const metaDescription =
  m.group === null
    ? `${verdict} What it is, what it does, and how processed the ${m.count} products here that contain it are.`
    : `${verdict} It appears in ${m.count} of the ${formatNumber(products.length)} products on this site. What it is, why NOVA counts it, and where it turns up.`;

const breadcrumbItems = [
  { name: 'Home', href: href() },
  { name: kindLabel, href: href(m.kind === 'additive' ? 'additives/' : 'ingredients/') },
  { name: label },
];
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((b, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: b.name,
      ...(b.href ? { item: new URL(b.href, Astro.site).href } : {}),
    })),
  },
];
---

<Base title={title} description={metaDescription} jsonLd={jsonLd}>
  <Breadcrumbs items={breadcrumbItems} />
  <div data-pagefind-body data-pagefind-meta={`kind:${m.kind === 'additive' ? 'Additive' : 'Ingredient'}`}>
    <span hidden data-pagefind-ignore data-pagefind-meta="image[data-src]" data-src="none"></span>
    <h1 data-pagefind-meta="title">{label}</h1>
    <p class="lede">{verdict}</p>
  </div>

  <section aria-labelledby="what">
    <h2 id="what">{explained ? 'What it is and why it counts' : 'What it is'}</h2>
    <p>{description}</p>
    {
      explained ? (
        <>
          <h3>{KINDS[explained.kind].title}</h3>
          <p>{KINDS[explained.kind].explanation}</p>
        </>
      ) : (
        <p>
          A product that contains it can still be ultra-processed for other reasons: {novaCounts[4]} of the {m.count}{' '}
          products here that contain {lower} ({ultraShare}%) are in group 4 because of other ingredients or additives.
        </p>
      )
    }
    {
      classes.length > 0 && (
        <>
          <h3>Function</h3>
          <dl class="classes">
            {classes.map((c) => (
              <>
                <dt>{c!.name}</dt>
                {c!.description && <dd>{c!.description}</dd>}
              </>
            ))}
          </dl>
          <p class="meta">Functional class definitions from the EU food additives regulation, via Open Food Facts.</p>
        </>
      )
    }
    {
      m.wikidata && (
        <p>
          <a href={`https://www.wikidata.org/wiki/${m.wikidata}`}>More about {lower} on Wikidata</a>
        </p>
      )
    }
  </section>

  <AdSlot name="marker-top" />

  <section aria-labelledby="where">
    <h2 id="where">Where it turns up</h2>
    <p>
      {label} appears in {m.count} of the {formatNumber(products.length)} products on this site ({percent(m.count, products.length)}%).
    </p>
    {
      m.topCategories.length > 0 && (
        <ul class="cats">
          {m.topCategories.map(([tag, n]) => {
            const c = categoryByTag.get(tag)!;
            return (
              <li>
                <a href={categoryHref(c)}>{c.name}</a>
                <span class="meta">
                  {' '}
                  {n} of {c.count} products
                </span>
              </li>
            );
          })}
        </ul>
      )
    }
    <h3>Products containing {lower}</h3>
    <ProductList products={listed} />
    {m.count > MAX_LISTED && <p class="meta">Showing the {MAX_LISTED} most popular of {m.count}.</p>}
  </section>

  <p class="meta">
    <a href={href('what-is-nova/')}>How the NOVA classification works</a>
  </p>
</Base>

<style>
  .classes dt {
    font-weight: 700;
  }
  .classes dd {
    margin: 0 0 0.75rem;
  }
  .cats {
    padding-left: 1.2rem;
    columns: 2 18rem;
  }
</style>
